# Copy this file to server/.env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
# Get from: MongoDB Atlas → your cluster → Connect → Drivers → copy the URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=<appName>

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
# false  → OTP is printed to the server console (development)
# true   → OTP is sent via Twilio SMS (production)
OTP_USE_SMS=false

# ─── Twilio SMS ──────────────────────────────────────────────────────────────
# Free trial at: https://www.twilio.com/try-twilio
# Step 1: Sign up (no credit card needed for trial)
# Step 2: Dashboard → Account SID + Auth Token
# Step 3: Phone Numbers → Get Trial Number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Client ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
